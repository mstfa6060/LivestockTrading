# ============================================================================
# Livestock Trading — Local Development Environment Variables (TEMPLATE)
# ============================================================================
# COPY this file to `.env` (in the SAME directory) and fill in real values.
# `.env` is gitignored — NEVER commit actual passwords.
#
# Phase 3 scope: PostgreSQL only.
# Phase 5 will add: Redis, RabbitMQ, MinIO, etc.
# ============================================================================

# ----------------------------------------------------------------------------
# PostgreSQL — Container superuser (used by Docker image entrypoint)
# ----------------------------------------------------------------------------
POSTGRES_SUPER_PASSWORD=change-me-superuser

# ----------------------------------------------------------------------------
# PostgreSQL — Application roles (created by init.sql)
# ----------------------------------------------------------------------------
# Migrator: DDL (CREATE/ALTER/DROP) + DML; used by EF migrations + SeedRunner
# App:      DML only (SELECT/INSERT/UPDATE/DELETE); runtime API + Workers
#
# Naming convention: LT__<Section>__<Key> (double underscore = .NET config nested)
# ----------------------------------------------------------------------------
LT__DATABASE__MIGRATORPASSWORD=change-me-migrator
LT__DATABASE__APPPASSWORD=change-me-app
