# ============================================================================
# Livestock Trading — Wave 0 Compose Env Template
# ============================================================================
# Usage:
#   cp .env.dev.example .env.dev
#   # Edit .env.dev with real passwords
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml \
#     --env-file .env.dev up -d
#
# Production: passwords from Vault (Wave 7+). Never commit .env.dev.
# ============================================================================

# ----------------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------------
# Superuser password (postgres user) — used by init.sh to create roles
POSTGRES_SUPER_PASSWORD=change-me-postgres-super

# Migrator role — DDL + DML (used by EF Core migrations)
LT__DATABASE__MIGRATORPASSWORD=change-me-migrator

# App role — DML-only (used by application runtime)
LT__DATABASE__APPPASSWORD=change-me-app

# ----------------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis

# ----------------------------------------------------------------------------
# RabbitMQ
# ----------------------------------------------------------------------------
RABBITMQ_USER=livestock_app
RABBITMQ_PASSWORD=change-me-rabbitmq

# ----------------------------------------------------------------------------
# MinIO
# ----------------------------------------------------------------------------
MINIO_ROOT_USER=livestock_minio_admin
MINIO_ROOT_PASSWORD=change-me-minio
