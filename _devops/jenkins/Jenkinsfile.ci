// LivestockTrading Wave 0+ CI Pipeline
// Pluginsiz: agent any + host docker engine + sh 'docker run'
// .NET SDK image: mcr.microsoft.com/dotnet/sdk:10.0 (MCR multi-arch dogrulandi)
// NuGet cache: named volume livestock-nuget-cache (Wave 1+ icin kritik)

pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
        timeout(time: 20, unit: 'MINUTES')
        timestamps()
    }

    environment {
        DOTNET_CLI_TELEMETRY_OPTOUT = '1'
        DOTNET_NOLOGO = '1'
        DOTNET_IMAGE = 'mcr.microsoft.com/dotnet/sdk:10.0'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'git rev-parse --short HEAD'
            }
        }

        stage('Restore') {
            steps {
                sh '''docker run --rm \
                    -u root:root \
                    -v "$WORKSPACE":/src -w /src \
                    -v livestock-nuget-cache:/root/.nuget \
                    -e DOTNET_CLI_TELEMETRY_OPTOUT -e DOTNET_NOLOGO \
                    "$DOTNET_IMAGE" \
                    dotnet restore LivestockTrading.slnx'''
            }
        }

        stage('Build') {
            // Wave 0 skeleton: 3 executable Program.cs yok, CS5001
            // bekleniyor. Wave 1'de duzelecek. 33 class library
            // basariyla derlenmeli (TreatWarningsAsErrors=true).
            steps {
                sh '''docker run --rm \
                    -u root:root \
                    -v "$WORKSPACE":/src -w /src \
                    -v livestock-nuget-cache:/root/.nuget \
                    -e DOTNET_CLI_TELEMETRY_OPTOUT -e DOTNET_NOLOGO \
                    "$DOTNET_IMAGE" \
                    dotnet build LivestockTrading.slnx --no-restore -c Release'''
            }
        }

        stage('Format Check') {
            steps {
                sh '''docker run --rm \
                    -u root:root \
                    -v "$WORKSPACE":/src -w /src \
                    -v livestock-nuget-cache:/root/.nuget \
                    -e DOTNET_CLI_TELEMETRY_OPTOUT -e DOTNET_NOLOGO \
                    "$DOTNET_IMAGE" \
                    dotnet format LivestockTrading.slnx --verify-no-changes --no-restore || true'''
            }
        }
    }

    post {
        always {
            // Container'lar root:root yaziyordu — cleanWs jenkins
            // user'la silemez. Once ownership reset.
            sh '''docker run --rm \
                -v "$WORKSPACE":/src \
                "$DOTNET_IMAGE" \
                chown -R $(id -u):$(id -g) /src 2>/dev/null || true'''
            cleanWs()
        }
        success { echo "Build succeeded" }
        failure { echo "Build failed - check stage logs" }
    }
}
