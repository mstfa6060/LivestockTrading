  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>LivestockTrading.Tools.AdminBootstrap</RootNamespace>
    <AssemblyName>LivestockTrading.Tools.AdminBootstrap</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared -->
    <ProjectReference Include="..\..\src\Shared\LivestockTrading.Shared.Infrastructure\LivestockTrading.Shared.Infrastructure.csproj" />

    <!-- Identity + Accounts (admin user creation needs both) -->
