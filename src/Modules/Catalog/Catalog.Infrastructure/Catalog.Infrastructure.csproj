<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>LivestockTrading.Catalog.Infrastructure</RootNamespace>
    <AssemblyName>LivestockTrading.Catalog.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Catalog.Application\Catalog.Application.csproj" />
    <ProjectReference Include="..\..\..\Shared\LivestockTrading.Shared.Infrastructure\LivestockTrading.Shared.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.8" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.8" />
    <PackageReference Include="Quartz" Version="[3.*, 4.0)" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="[3.*, 4.0)" />
    <PackageReference Include="Scrutor" Version="[5.*,6.0)" />
    <PackageReference Include="StackExchange.Redis" Version="[2.*, 3.0)" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="[10.*, 11.0)" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="[10.*, 11.0)" />
  </ItemGroup>

</Project>
